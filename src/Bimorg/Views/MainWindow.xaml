<Window x:Class="Bimorg.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:c="clr-namespace:Bimorg.Converters"
        xmlns:vm="clr-namespace:Bimorg.ViewModels"
        mc:Ignorable="d"
        Title="Bimorg"
        Height="840"
        Width="1600"
        TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
        Loaded="MainWindow_OnLoaded">
  <Window.Resources>
    <c:BytesToImageConverter x:Key="BytesToImage" />
    <Color x:Key="Bimorg.ThumbnailCardBackgroundColor">#FFEBEBEB</Color>
    <SolidColorBrush x:Key="Bimorg.ThumbnailCardBackground" Color="{StaticResource Bimorg.ThumbnailCardBackgroundColor}" />
    <SolidColorBrush x:Key="Bimorg.ThumbnailPrimaryText" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Bimorg.ThumbnailSecondaryText" Color="#FF424242" />
    <Style x:Key="Bimorg.MetroToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Margin="0,0,0,2">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="Exit_OnClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Preferences..." Click="Preferences_OnClick" />
      </MenuItem>
    </Menu>

    <DockPanel Margin="14">
      <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,4" LastChildFill="True">
      <TextBlock DockPanel.Dock="Right"
                 Margin="14,2,0,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
        <Run Text="Showing " />
        <Run Text="{Binding ResultCount, Mode=OneWay}" />
        <Run Text=" results" />
      </TextBlock>
      <StackPanel>
        <TextBlock Text="{Binding StatusLine}"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
      </StackPanel>
    </DockPanel>

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Margin="0,0,0,6"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                 Text="Keywords" />
      <DockPanel Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Margin="10,0,0,0"
                    VerticalAlignment="Bottom">
          <Button Padding="18,12"
                  MinHeight="44"
                  Margin="0,0,10,0"
                  FontWeight="SemiBold"
                  Style="{StaticResource Bimorg.MetroToolbarButtonStyle}"
                  Content="Search"
                  Command="{Binding RefreshSearchCommand}" />
          <Button Padding="14,10"
                  MinHeight="44"
                  Style="{StaticResource Bimorg.MetroToolbarButtonStyle}"
                  Content="Clear"
                  Command="{Binding ClearKeywordsCommand}" />
        </StackPanel>
        <TextBox MinHeight="42" Padding="10,10"
                 Text="{Binding KeywordsFilter, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>
    </StackPanel>

    <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6"
            Margin="0,0,0,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:MapTileVm}">
              <!-- Thumb slot ~= 226px (7+212+7) so 8 cols fit typical ~1820–1880px content width on 1920×1080. -->
              <Button Width="212"
                      Margin="7"
                      Padding="0"
                      Focusable="False"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      MouseDoubleClick="Thumbnail_OnMouseDoubleClick">
                <Button.ToolTip>
                  <Border MaxWidth="440"
                          Padding="10"
                          Background="{DynamicResource MahApps.Brushes.Gray10}"
                          BorderBrush="{DynamicResource MahApps.Brushes.Gray6}"
                          BorderThickness="1">
                    <StackPanel>
                      <TextBlock Text="{Binding Description, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                      <TextBlock Margin="0,0,0,8"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
                        <Run FontWeight="SemiBold" Text="Keywords: " />
                        <Run Text="{Binding KeywordsLabel, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding FilePath, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                    </StackPanel>
                  </Border>
                </Button.ToolTip>
                <Border Padding="10"
                        CornerRadius="6"
                        Background="{StaticResource Bimorg.ThumbnailCardBackground}"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray6}"
                        BorderThickness="1">
                  <StackPanel TextElement.Foreground="{StaticResource Bimorg.ThumbnailPrimaryText}">
                    <Image Width="192" Height="192" Stretch="Uniform" HorizontalAlignment="Center"
                           Source="{Binding ThumbnailData, Converter={StaticResource BytesToImage}}" />
                    <TextBlock Margin="4,10,4,6"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Bimorg.ThumbnailPrimaryText}"
                               Text="{Binding FileName}" />
                    <TextBlock Foreground="{StaticResource Bimorg.ThumbnailSecondaryText}"
                               Margin="4,0,4,4"
                               Text="{Binding DimensionsLabel}" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    </DockPanel>
  </DockPanel>
</Window>
